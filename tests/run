#!/bin/bash
# Run the tests: tests/run [--live] [file.test.sh ...]
#   --live         also run live.test.sh, which serves over the tailnet with the real tailscale
#   TEST_FILTER    run only the tests whose name contains it
# First the Go unit tests and a build for every platform, then the command line tests against a
# build of tailshare. Every test but live.test.sh uses a fake tailscale, so it never touches the
# real tailscale serve config.
set -uo pipefail

tests="$(cd "$(dirname "$0")" && pwd -P)"
root="$(dirname "$tests")"
files=()
if [[ "${1:-}" == --live ]]; then
	export TAILSHARE_LIVE=1
	shift
fi
if (($#)); then
	for file in "$@"; do
		files+=("$(cd "$(dirname "$file")" && pwd -P)/$(basename "$file")")
	done
else
	for file in "$tests"/*.test.sh; do
		files+=("$file")
	done
fi

failed=0
cd "$root" || exit 1
if (($# == 0)); then
	echo "# go vet and go test"
	{ go vet ./... && go test ./...; } || failed=$((failed + 1))
	for platform in darwin/arm64 darwin/amd64 linux/amd64 linux/arm64 windows/amd64; do
		GOOS="${platform%/*}" GOARCH="${platform#*/}" go build -o /dev/null . \
			|| { echo "FAIL    go build for $platform"; failed=$((failed + 1)); }
	done
	echo "# builds for darwin, linux and windows"
fi

build="$(mktemp -d "${TMPDIR:-/tmp}/tailshare-test-build.XXXXXX")"
trap 'rm -rf "$build"' EXIT
go build -o "$build/tailshare" . || exit 1
export TAILSHARE="$build/tailshare"
for file in "${files[@]}"; do
	bash "$file" || failed=$((failed + 1))
done
if ((failed)); then
	echo "# $failed failed"
	exit 1
fi
echo "# all passed"
