#!/bin/bash
# A stand-in for the tailscale CLI, for the parts tailshare uses. It never touches the real tailscale.
#
#   FAKE_TAILSCALE_DIR     where it keeps its serve config and its call log: serve/<port> holds the target
#                          of a port served in the background (--bg), foreground/<port> that of a
#                          `tailscale serve` running in the foreground, for as long as it runs
#   FAKE_TAILSCALE_STATE   what `status` reports: Running (default), Stopped, NeedsLogin, ...,
#                          or "down" for a daemon that does not answer
#   FAKE_TAILSCALE_SERVE   "fail" makes `serve` fail; "denied" fails it as Linux does for a user who is
#                          not the operator
#   FAKE_TAILSCALE_FOREGROUND  ports that another program's `tailscale serve` holds in the foreground
#   FAKE_TAILSCALE_BUSY    how many times `serve` fails first because another client is changing the
#                          serve config; FAKE_TAILSCALE_BUSY_OFF the same for `serve ... off`
set -euo pipefail

dir="${FAKE_TAILSCALE_DIR:?FAKE_TAILSCALE_DIR is not set}"
state="${FAKE_TAILSCALE_STATE:-Running}"
mkdir -p "$dir/serve" "$dir/foreground"
echo "$*" >> "$dir/calls"

if [[ "$state" == down ]]; then
	echo "failed to connect to local Tailscale service; is Tailscale running?" >&2
	exit 1
fi

# Fail as tailscale does when another client changed the serve config, the first $1 times
busy() {
	local count=0
	[[ -f "$dir/busy-$2" ]] && count="$(cat "$dir/busy-$2")"
	if ((count < $1)); then
		echo $((count + 1)) > "$dir/busy-$2"
		echo "Another client is changing the serve config; please try again." >&2
		exit 1
	fi
}

case "$*" in
	"status --json")
		printf '{"BackendState": "%s", "Self": {"DNSName": "host.example.ts.net.", "Online": true}}\n' "$state"
		;;
	"serve status --json")
		# As the real one says it: the ports in TCP, and where each one's / is proxied to in Web
		tcp="" web=""
		for file in "$dir/serve"/*; do
			[[ -f "$file" ]] || continue
			port="$(basename "$file")"
			tcp+="${tcp:+, }\"$port\": {\"HTTPS\": true}"
			web+="${web:+, }\"host.example.ts.net:$port\": {\"Handlers\": {\"/\": {\"Proxy\": \"$(cat "$file")\"}}}"
		done
		# A tailscale serve in the foreground keeps its config apart, under its session
		sessions=""
		for file in "$dir/foreground"/*; do
			[[ -f "$file" ]] || continue
			port="$(basename "$file")"
			sessions+="${sessions:+, }\"session-$port\": {\"TCP\": {\"$port\": {\"HTTPS\": true}}, \"Web\": {\"host.example.ts.net:$port\": {\"Handlers\": {\"/\": {\"Proxy\": \"$(cat "$file")\"}}}}}"
		done
		others=""
		for port in ${FAKE_TAILSCALE_FOREGROUND:-}; do
			others+="${others:+, }\"$port\": {\"HTTPS\": true}"
		done
		[[ -n "$others" ]] && sessions+="${sessions:+, }\"session-other\": {\"TCP\": {$others}}"
		json=""
		[[ -n "$tcp" ]] && json+="\"TCP\": {$tcp}, \"Web\": {$web}"
		[[ -n "$sessions" ]] && json+="${json:+, }\"Foreground\": {$sessions}"
		echo "{$json}"
		;;
	"serve --bg --https="*)
		busy "${FAKE_TAILSCALE_BUSY:-0}" bg
		[[ "${FAKE_TAILSCALE_SERVE:-}" != fail ]] || { echo "serve: HTTPS is not enabled" >&2; exit 1; }
		[[ "${FAKE_TAILSCALE_SERVE:-}" != denied ]] || { echo "Access denied: serve config denied" >&2; exit 1; }
		port="${3#--https=}"
		echo "$4" > "$dir/serve/$port"
		;;
	"serve --https="*" off")
		busy "${FAKE_TAILSCALE_BUSY_OFF:-0}" off
		port="${2#--https=}"
		rm -f "$dir/serve/$port"
		;;
	"serve --https="*" "*)
		# In the foreground: the config lasts as long as this process does
		busy "${FAKE_TAILSCALE_BUSY:-0}" foreground
		[[ "${FAKE_TAILSCALE_SERVE:-}" != fail ]] || { echo "serve: HTTPS is not enabled" >&2; exit 1; }
		[[ "${FAKE_TAILSCALE_SERVE:-}" != denied ]] || { echo "Access denied: serve config denied" >&2; exit 1; }
		port="${2#--https=}"
		trap 'rm -f "$dir/foreground/$port"; exit 0' TERM INT HUP
		echo "$3" > "$dir/foreground/$port"
		printf 'Available within your tailnet:\n\nhttps://host.example.ts.net:%s/\n|-- proxy %s\n\nPress Ctrl+C to exit.\n' "$port" "$3"
		while :; do
			sleep 0.1
		done
		;;
	*)
		echo "fake tailscale: not implemented: $*" >&2
		exit 1
		;;
esac
