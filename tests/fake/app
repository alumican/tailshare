#!/usr/bin/env python3
"""A stand-in for an app running on this machine, to share with tailshare http://127.0.0.1:<port>.

Writes the port it listens on to the file given, then serves:
  GET  /             a page whose link starts with / (as an app's own links do)
  GET  /api/hello    who asked: the Host it was sent and the login tailscale serve added
  POST /upload       how many bytes it received
  GET  /stream       two server-sent events, a second apart
"""
import http.server
import json
import sys
import time


class App(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def send(self, body, content_type="text/plain"):
        data = body.encode()
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        if self.path == "/":
            self.send('<a href="/api/hello">hello</a>', "text/html")
        elif self.path == "/api/hello":
            self.send(json.dumps({"host": self.headers["Host"], "login": self.headers.get("Tailscale-User-Login", ""),
                                  "forwardedHost": self.headers.get("X-Forwarded-Host", "")}), "application/json")
        elif self.path == "/stream":
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Connection", "close")
            self.end_headers()
            for event in ("first", "second"):
                self.wfile.write(f"data: {event}\n\n".encode())
                self.wfile.flush()
                time.sleep(1)
            self.close_connection = True
        else:
            self.send_error(404)

    def do_POST(self):
        length = int(self.headers.get("Content-Length", "0"))
        received = 0
        while received < length:
            chunk = self.rfile.read(min(1 << 20, length - received))
            if not chunk:
                break
            received += len(chunk)
        self.send(str(received))

    def log_message(self, *args):
        pass


server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), App)
with open(sys.argv[1], "w") as f:
    f.write(str(server.server_address[1]))
server.serve_forever()
