#!/bin/bash
# tailshare: serve a file or a directory to your tailnet over HTTPS, and print its URL.
# What is served for a path is decided by adapters (see README.md). Requires tailscale and python3.
# Written for bash 3.2, the one macOS ships.

set -euo pipefail

VERSION="2.1.0"
PROG="$(basename "$0")"

# This script, through any symlinks (e.g. ~/.local/bin/tailshare)
self="$0"
while [[ -L "$self" ]]; do
	target="$(readlink "$self")"
	[[ "$target" == /* ]] && self="$target" || self="$(dirname "$self")/$target"
done
HERE="$(cd "$(dirname "$self")" && pwd -P)"
SELF="$HERE/$(basename "$self")"

# Where adapters are looked for, first wins for the same name
ADAPTER_PATH="${TAILSHARE_ADAPTER_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/tailshare/adapters:$HERE/adapters}"
# Where running shares are recorded, one file per port, so --list and --stop can find them
STATE_DIR="${TAILSHARE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/tailshare}"

usage() {
	cat <<EOF
Usage: $PROG [options] <path>      serve a path
       $PROG --list                show running shares
       $PROG --stop <port|all>     stop running shares
       $PROG --adapters            list the adapters
       $PROG --which <path>        show which adapter would serve a path

Try '$PROG --help' for more.
EOF
}

help() {
	cat <<EOF
$PROG $VERSION - serve a file or a directory to your tailnet over HTTPS

USAGE
  $PROG [options] <path>
  $PROG --list | --stop <port|all> | --adapters | --which <path>

DESCRIPTION
  Serves <path> over HTTPS to the devices on your tailnet only, and prints its URL.
  Stops after --time or on Ctrl-C, and leaves nothing behind: the tailscale serve
  config, the local server and every temporary file are removed. The path itself is
  never copied or changed.

  What is served is decided by the first adapter whose patterns match the path:
    *.ipa           an install page for iPhone (with its manifest)
    *.html, *.htm   the page and the local files it refers to, nothing else
    a directory     the directory at /, without hidden entries (.git, .env, ...)
    anything else   that one file
  See them with --adapters; add your own in ~/.config/tailshare/adapters (README.md).

OPTIONS
  -p, --port PORT    tailnet HTTPS port. Default: the first of 10443, 11443, ...
                     that tailscale serve does not use. A port in use is refused.
  -t, --time TIME    stop after TIME: 90 (seconds), 30s, 10m, 2h, or 0 for never.
                     Default: 1h.
  -a, --as NAME      use this adapter whatever the path is: ipa, html, dir, file, ...
  -d, --detach       serve in the background: print the URL and return at once.
                     Stop it with --stop, or let --time end it.
  -j, --json         print one JSON object per line instead of plain text
                     (for serving, --list, --adapters and --which).
  -q, --quiet        print nothing to stderr (no messages, no request log).
      --list         show running shares: port, URL, adapter, path, until when.
      --stop TARGET  stop the share on port TARGET, or all of them with "all".
      --adapters     list the adapters in the order they are tried.
      --which PATH   show which adapter would serve PATH; serve nothing.
  -h, --help         show this help.  -V, --version  show the version.

OUTPUT
  stdout carries only the result: the URL when serving (one line), or the listing.
  With --json, serving prints:
    {"url": "...", "port": 10443, "adapter": "html", "path": "...", "pid": 123,
     "expires": "2026-01-01T12:00:00+0900"}        (expires is null with --time 0)
  stderr carries messages and the request log, unless --quiet.

EXIT STATUS
  0  served and stopped normally (time up, Ctrl-C, --stop), or the query succeeded
  1  error: no such path, no adapter, port in use, tailscale not running, ...
  2  wrong arguments

ENVIRONMENT
  TAILSHARE_ADAPTER_PATH  where adapters are looked for, separated by ":"
                          (now: $ADAPTER_PATH)
  TAILSHARE_STATE_DIR     where running shares are recorded (now: $STATE_DIR)

EXAMPLES
  $PROG report.html                 share a page for an hour
  $PROG -t 0 ./dist                 share a built site until Ctrl-C
  $PROG -t 10m App.ipa              an iPhone install page for ten minutes
  url=\$($PROG -d -q notes.pdf)     share in the background, keep the URL
  $PROG -d -j build/ | jq -r .url   the same, as JSON
  $PROG --list                      what is being shared now
  $PROG --stop all                  stop everything shared

REQUIRES
  tailscale (with HTTPS certificates enabled on the tailnet), python3, bash
EOF
}

die() {
	echo "$PROG: $*" >&2
	exit 1
}

usage_error() {
	echo "$PROG: $*" >&2
	echo "Try '$PROG --help'." >&2
	exit 2
}

# One JSON object from key/value pairs; values are strings, except numbers, true, false and null
json_object() {
	python3 -c '
import json, sys
pairs = sys.argv[1:]
obj = {}
for key, value in zip(pairs[::2], pairs[1::2]):
    if value in ("null", "true", "false"):
        obj[key] = json.loads(value)
    elif value.isdigit():
        obj[key] = int(value)
    else:
        obj[key] = value
print(json.dumps(obj, ensure_ascii=False))
' "$@"
}

# MARK: - Adapters

# Every adapter as "name<TAB>directory", in the order they are tried: by name, the first in ADAPTER_PATH for a name
list_adapters() {
	echo "$ADAPTER_PATH" | tr ':' '\n' | {
		seen=$'\n'
		while IFS= read -r search; do
			[[ -n "$search" && -d "$search" ]] || continue
			for entry in "$search"/*/; do
				[[ -d "$entry" ]] || continue
				name="$(basename "$entry")"
				[[ "$seen" == *$'\n'"$name"$'\n'* ]] && continue
				seen+="$name"$'\n'
				printf '%s\t%s\n' "$name" "${entry%/}"
			done
		done
	} | LC_ALL=C sort
}

# The patterns of an adapter on one line, without comments
adapter_patterns() {
	if [[ -f "$1/match" ]]; then
		sed -e 's/#.*//' "$1/match" | tr -s ' \t\n' ' ' | sed -e 's/^ //' -e 's/ $//'
	fi
}

# What an adapter serves: the first comment of its match file
adapter_description() {
	if [[ -f "$1/match" ]]; then
		sed -n -e 's/^#[[:space:]]*//p' "$1/match" | head -n 1
	fi
}

# Whether an adapter's patterns accept the path: @dir for a directory, shell globs on the name of anything else
adapter_matches() {
	local dir="$1" input="$2" name pattern matched=1
	name="$(basename "$input")"
	set -f
	for pattern in $(adapter_patterns "$dir"); do
		if [[ "$pattern" == "@dir" ]]; then
			[[ -d "$input" ]] && matched=0
		elif [[ ! -d "$input" ]]; then
			shopt -s nocasematch
			[[ "$name" == $pattern ]] && matched=0
			shopt -u nocasematch
		fi
		((matched == 0)) && break
	done
	set +f
	return $matched
}

# The name of an adapter without its ordering number: 10-ipa -> ipa
short_name() {
	echo "${1#[0-9]*-}"
}

# "name<TAB>directory" of the adapter for the path, or of the one asked for with --as
find_adapter() {
	local input="$1" wanted="${2:-}" name dir
	while IFS=$'\t' read -r name dir; do
		if [[ -n "$wanted" ]]; then
			[[ "$name" == "$wanted" || "$(short_name "$name")" == "$wanted" ]] || continue
		else
			adapter_matches "$dir" "$input" || continue
		fi
		if [[ ! -x "$dir/prepare" ]]; then
			echo "$PROG: warning: skipping adapter $name: $dir/prepare is missing or not executable" >&2
			[[ -n "$wanted" ]] && return 1
			continue
		fi
		printf '%s\t%s\n' "$name" "$dir"
		return 0
	done < <(list_adapters)
	return 1
}

show_adapters() {
	local name dir patterns description usable
	while IFS=$'\t' read -r name dir; do
		patterns="$(adapter_patterns "$dir")"
		description="$(adapter_description "$dir")"
		usable=true
		[[ -x "$dir/prepare" ]] || usable=false
		if ((json)); then
			json_object name "$(short_name "$name")" id "$name" patterns "$patterns" description "$description" dir "$dir" usable "$usable"
		else
			printf '%-6s %-14s %s\n' "$(short_name "$name")" "$patterns" "$description"
			printf '%-6s %-14s %s%s\n' "" "" "$dir" "$([[ "$usable" == true ]] || echo "  (skipped: prepare is not executable)")"
		fi
	done < <(list_adapters)
}

# MARK: - Running shares

# A field of a share's state file
field() {
	sed -n "s/^$1=//p" "$2" | head -n 1
}

# State files of the shares still running; those whose process is gone are removed
running_shares() {
	local file pid
	[[ -d "$STATE_DIR" ]] || return 0
	for file in "$STATE_DIR"/[0-9]*; do
		[[ -f "$file" ]] || continue
		pid="$(field pid "$file")"
		if [[ -n "$pid" ]] && kill -0 "$pid" 2> /dev/null; then
			echo "$file"
		else
			rm -f "$file"
		fi
	done
}

show_shares() {
	local file expires until count=0
	while IFS= read -r file; do
		count=$((count + 1))
		expires="$(field expires "$file")"
		if ((json)); then
			json_object url "$(field url "$file")" port "$(field port "$file")" adapter "$(field adapter "$file")" \
				path "$(field path "$file")" pid "$(field pid "$file")" expires "${expires:-null}"
		else
			until="${expires:+until $(echo "$expires" | cut -c 12-16)}"
			printf '%-5s %-6s %-12s %s\n' "$(field port "$file")" "$(field adapter "$file")" "${until:-until stopped}" "$(field url "$file")"
			printf '%-5s %-6s %-12s %s\n' "" "" "" "$(field path "$file")"
		fi
	done < <(running_shares)
	((json || count > 0)) || echo "Nothing is being shared." >&2
	return 0
}

stop_shares() {
	local target="$1" file pid url stopped=0
	while IFS= read -r file; do
		[[ "$target" == all || "$(field port "$file")" == "$target" ]] || continue
		pid="$(field pid "$file")"
		url="$(field url "$file")"
		kill -TERM "$pid" 2> /dev/null || true
		# Its own cleanup removes the state file once the share is down
		for _ in $(seq 50); do
			[[ -f "$file" ]] || break
			sleep 0.1
		done
		echo "Stopped $url" >&2
		stopped=$((stopped + 1))
	done < <(running_shares)
	((stopped > 0)) || [[ "$target" == all ]] || die "nothing is shared on port $target (see $PROG --list)"
	return 0
}

# MARK: - Arguments

port=""
time_spec="1h"
quiet=0
json=0
detach=0
adapter_wanted=""
mode="serve"
stop_target=""
path=""

needs_value() {
	(($1 >= 2)) || usage_error "$2 needs a value"
}

if (($# == 0)); then
	usage >&2
	exit 2
fi
while (($#)); do
	case "$1" in
		-p | --port) needs_value $# "$1"; port="$2"; shift 2 ;;
		--port=*) port="${1#*=}"; shift ;;
		-t | --time) needs_value $# "$1"; time_spec="$2"; shift 2 ;;
		--time=*) time_spec="${1#*=}"; shift ;;
		-a | --as) needs_value $# "$1"; adapter_wanted="$2"; shift 2 ;;
		--as=*) adapter_wanted="${1#*=}"; shift ;;
		-d | --detach) detach=1; shift ;;
		-j | --json) json=1; shift ;;
		-q | --quiet) quiet=1; shift ;;
		--list) mode="list"; shift ;;
		--stop) needs_value $# "$1"; mode="stop"; stop_target="$2"; shift 2 ;;
		--stop=*) mode="stop"; stop_target="${1#*=}"; shift ;;
		--adapters) mode="adapters"; shift ;;
		--which) mode="which"; shift ;;
		-h | --help) help; exit 0 ;;
		-V | --version) echo "$PROG $VERSION"; exit 0 ;;
		--) shift; break ;;
		-[a-zA-Z][a-zA-Z]*)
			# Bundled short options without values, such as -dq
			flags="${1#-}"
			shift
			while [[ -n "$flags" ]]; do
				case "${flags:0:1}" in
					d) detach=1 ;; j) json=1 ;; q) quiet=1 ;;
					*) usage_error "-${flags:0:1} cannot be combined with other options; give it on its own" ;;
				esac
				flags="${flags:1}"
			done
			;;
		-*) usage_error "unknown option: $1" ;;
		*) [[ -z "$path" ]] || usage_error "only one path can be served (got '$path' and '$1')"; path="$1"; shift ;;
	esac
done
if (($#)); then
	[[ -z "$path" && $# -eq 1 ]] || usage_error "only one path can be served"
	path="$1"
fi

case "$mode" in
	adapters) show_adapters; exit 0 ;;
	list) show_shares; exit 0 ;;
	stop)
		[[ "$stop_target" == all || "$stop_target" =~ ^[0-9]+$ ]] || usage_error "--stop takes a port or 'all'"
		stop_shares "$stop_target"
		exit 0
		;;
esac

[[ -n "$path" ]] || usage_error "no path given"
[[ -z "$port" || "$port" =~ ^[0-9]+$ && "$port" -ge 1 && "$port" -le 65535 ]] || usage_error "invalid port: $port"
[[ "$time_spec" =~ ^[0-9]+[smh]?$ ]] || usage_error "invalid time: $time_spec (use 90, 30s, 10m, 2h or 0)"
[[ -e "$path" ]] || die "no such file or directory: $path"
[[ -r "$path" ]] || die "cannot read: $path"

case "$time_spec" in
	*h) seconds=$((${time_spec%h} * 3600)) ;;
	*m) seconds=$((${time_spec%m} * 60)) ;;
	*s) seconds=${time_spec%s} ;;
	*) seconds=$time_spec ;;
esac

if [[ -d "$path" ]]; then
	abs_path="$(cd "$path" && pwd -P)"
else
	abs_path="$(cd "$(dirname "$path")" && pwd -P)/$(basename "$path")"
fi

if ! found="$(find_adapter "$abs_path" "$adapter_wanted")"; then
	[[ -n "$adapter_wanted" ]] && die "no usable adapter named $adapter_wanted (see $PROG --adapters)"
	die "no adapter matches $path (see $PROG --adapters)"
fi
adapter_name="${found%%$'\t'*}"
adapter_dir="${found#*$'\t'}"
adapter="$(short_name "$adapter_name")"

if [[ "$mode" == "which" ]]; then
	if ((json)); then
		json_object adapter "$adapter" id "$adapter_name" dir "$adapter_dir" path "$abs_path"
	else
		printf '%s\t%s\n' "$adapter" "$adapter_dir"
	fi
	exit 0
fi

say() {
	((quiet)) || echo "$*" >&2
}

# MARK: - Detach

# Run this same command in the background, and hand back what it prints once it is serving
if ((detach)); then
	mkdir -p "$STATE_DIR"
	log="$(mktemp "$STATE_DIR/log.XXXXXX")"
	out="$(mktemp "${TMPDIR:-/tmp}/tailshare-out.XXXXXX")"
	args=(--time "$time_spec" --as "$adapter_name")
	[[ -n "$port" ]] && args+=(--port "$port")
	((json)) && args+=(--json)
	TAILSHARE_LOG="$log" nohup "$SELF" "${args[@]}" -- "$abs_path" > "$out" 2> "$log" < /dev/null &
	child=$!
	for _ in $(seq 300); do
		[[ -s "$out" ]] && break
		kill -0 "$child" 2> /dev/null || break
		sleep 0.1
	done
	if [[ -s "$out" ]]; then
		cat "$out"
		served_port="$(grep -oE ':[0-9]+/' "$out" | head -n 1 | tr -d ':/')"
		rm -f "$out"
		say "Serving in the background (pid $child). Stop it with: $PROG --stop $served_port"
		exit 0
	fi
	rm -f "$out"
	kill "$child" 2> /dev/null || true
	cat "$log" >&2
	rm -f "$log"
	die "failed to start in the background"
fi

# MARK: - Tools

tailscale_bin="$(command -v tailscale || true)"
if [[ -z "$tailscale_bin" && -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]]; then
	tailscale_bin=/Applications/Tailscale.app/Contents/MacOS/Tailscale
fi
[[ -n "$tailscale_bin" ]] || die "tailscale not found; install it, or put it on PATH"
command -v python3 > /dev/null || die "python3 not found"

host="$("$tailscale_bin" status --json 2> /dev/null | python3 -c 'import json, sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2> /dev/null)" \
	|| die "tailscale is not running or not logged in"
[[ -n "$host" ]] || die "could not find this device's tailnet name"

# Whether tailscale serve already uses the port, for anything
serve_uses() {
	"$tailscale_bin" serve status --json 2> /dev/null \
		| python3 -c 'import json, sys; d = json.load(sys.stdin) or {}; sys.exit(0 if sys.argv[1] in (d.get("TCP") or {}) else 1)' "$1"
}

if [[ -z "$port" ]]; then
	for ((candidate = 10443; candidate <= 65443; candidate += 1000)); do
		if ! serve_uses "$candidate"; then
			port=$candidate
			break
		fi
	done
	[[ -n "$port" ]] || die "no free port among 10443, 11443, ... 65443; choose one with --port"
elif serve_uses "$port"; then
	die "port $port is already used by tailscale serve; choose another, or leave --port out"
fi
base_url="https://$host:$port"

# MARK: - What to serve

# Everything served lives in a temporary directory, removed on exit; adapters link to the path rather than copy it
root="$(mktemp -d "${TMPDIR:-/tmp}/tailshare.XXXXXX")"
state_file=""
server_pid=""
serving=0

cleanup() {
	trap - EXIT INT TERM HUP
	if ((serving)); then
		"$tailscale_bin" serve --https="$port" off > /dev/null 2>&1 || true
	fi
	if [[ -n "$server_pid" ]]; then
		kill "$server_pid" 2> /dev/null || true
		wait "$server_pid" 2> /dev/null || true
	fi
	rm -rf "$root"
	[[ -n "$state_file" ]] && rm -f "$state_file"
	[[ -n "${TAILSHARE_LOG:-}" ]] && rm -f "$TAILSHARE_LOG"
	((serving)) && say "Stopped serving $base_url/"
	return 0
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP

# The adapter fills the site and prints the path to open, such as / or /report.html (not URL-encoded)
mkdir "$root/site"
url_path="$(TAILSHARE_ADAPTER_DIR="$adapter_dir" "$adapter_dir/prepare" "$abs_path" "$root/site" "$base_url")" \
	|| die "adapter $adapter failed for $path"
url_path="$(printf '%s\n' "$url_path" | tail -n 1)"
[[ "$url_path" == /* ]] || die "adapter $adapter printed no path to open (got: ${url_path:-nothing})"
url="$base_url$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe="/"))' "$url_path")"

# MARK: - Serve

local_port="$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')"
if ((quiet)); then
	python3 -m http.server "$local_port" --bind 127.0.0.1 --directory "$root/site" > /dev/null 2>&1 &
else
	python3 -m http.server "$local_port" --bind 127.0.0.1 --directory "$root/site" > /dev/null &
fi
server_pid=$!

# Wait until the local server answers before exposing it
for _ in $(seq 50); do
	python3 -c 'import socket, sys; socket.create_connection(("127.0.0.1", int(sys.argv[1])), 0.1)' "$local_port" 2> /dev/null && break
	kill -0 "$server_pid" 2> /dev/null || die "the local server failed to start"
	sleep 0.1
done

serving=1
"$tailscale_bin" serve --bg --https="$port" "http://127.0.0.1:$local_port" > /dev/null 2>&1 \
	|| die "tailscale serve failed (are HTTPS certificates enabled on the tailnet?)"

expires=""
((seconds > 0)) && expires="$(date -r $(($(date +%s) + seconds)) '+%Y-%m-%dT%H:%M:%S%z')"
mkdir -p "$STATE_DIR"
state_file="$STATE_DIR/$port"
cat > "$state_file" <<EOF
port=$port
url=$url
adapter=$adapter
path=$abs_path
pid=$$
expires=$expires
EOF

if ((json)); then
	json_object url "$url" port "$port" adapter "$adapter" path "$abs_path" pid "$$" expires "${expires:-null}"
else
	echo "$url"
fi
if ((seconds > 0)); then
	say "Serving $path as $adapter on your tailnet for $time_spec. Ctrl-C to stop."
else
	say "Serving $path as $adapter on your tailnet. Ctrl-C to stop."
fi

start=$SECONDS
while kill -0 "$server_pid" 2> /dev/null; do
	if ((seconds > 0 && SECONDS - start >= seconds)); then
		say "Time is up ($time_spec)."
		exit 0
	fi
	sleep 1
done
die "the local server stopped"
