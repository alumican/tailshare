#!/bin/bash
# tailshare: serve a file or a directory to your tailnet over HTTPS, and print its URL.
# What is served for a path is decided by adapters (see README.md). Requires tailscale and python3.
# Written for bash 3.2, the one macOS ships.

set -euo pipefail

VERSION="2.0.0"
PROG="$(basename "$0")"

# The directory of this script, through any symlinks (e.g. ~/.local/bin/tailshare)
self="$0"
while [[ -L "$self" ]]; do
	target="$(readlink "$self")"
	[[ "$target" == /* ]] && self="$target" || self="$(dirname "$self")/$target"
done
HERE="$(cd "$(dirname "$self")" && pwd -P)"

# Where adapters are looked for, first wins for the same name
ADAPTER_PATH="${TAILSHARE_ADAPTER_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/tailshare/adapters:$HERE/adapters}"

usage() {
	cat <<EOF
Usage: $PROG [options] <path>
       $PROG --adapters
       $PROG --which <path>

Serve a file or a directory to your tailnet over HTTPS, and print its URL.
Only devices on your tailnet can open it. Stops after --time or on Ctrl-C,
and leaves nothing behind.

What is served is decided by the first adapter whose patterns match the path:
an install page for an .ipa, an HTML page with the files it refers to,
a directory, or any other file. Run \`$PROG --adapters\` to see them all.

Options:
  -p, --port PORT   tailnet HTTPS port (default: the first free of 10443, 11443, ...)
  -t, --time TIME   stop after TIME: 90, 30s, 10m, 2h, or 0 to keep serving (default: 1h)
  -a, --as NAME     use this adapter, whatever the path is (e.g. --as file)
  -q, --quiet       print nothing but the URL
      --adapters    list the adapters, in the order they are tried
      --which PATH  show which adapter would serve PATH, and serve nothing
  -h, --help        show this help
  -V, --version     show the version

The URL is the only thing written to stdout; messages and the request log go to
stderr (none with --quiet). Ports that tailscale serve already uses are never touched.

Examples:
  $PROG report.html            share a page for an hour
  $PROG -t 0 ./dist            share a built site until Ctrl-C
  $PROG -t 10m App.ipa         an iPhone install page for ten minutes

Adapters are looked for in (first wins for the same name; set TAILSHARE_ADAPTER_PATH to change):
$(echo "$ADAPTER_PATH" | tr ':' '\n' | sed 's/^/  /')

Requires: tailscale with HTTPS certificates enabled, python3
EOF
}

die() {
	echo "$PROG: $*" >&2
	exit 1
}

usage_error() {
	echo "$PROG: $*" >&2
	echo "Try '$PROG --help'." >&2
	exit 2
}

# MARK: - Adapters

# Every adapter as "name<TAB>directory", in the order they are tried: by name, the first in ADAPTER_PATH for a name
list_adapters() {
	echo "$ADAPTER_PATH" | tr ':' '\n' | {
		seen=$'\n'
		while IFS= read -r search; do
			[[ -n "$search" && -d "$search" ]] || continue
			for entry in "$search"/*/; do
				[[ -d "$entry" ]] || continue
				name="$(basename "$entry")"
				[[ "$seen" == *$'\n'"$name"$'\n'* ]] && continue
				seen+="$name"$'\n'
				printf '%s\t%s\n' "$name" "${entry%/}"
			done
		done
	} | LC_ALL=C sort
}

# The patterns of an adapter on one line, without comments
adapter_patterns() {
	if [[ -f "$1/match" ]]; then
		sed -e 's/#.*//' "$1/match" | tr -s ' \t\n' ' ' | sed -e 's/^ //' -e 's/ $//'
	fi
}

# Whether an adapter's patterns accept the path: @dir for a directory, shell globs on the name of anything else
adapter_matches() {
	local dir="$1" input="$2" name pattern matched=1
	name="$(basename "$input")"
	set -f
	for pattern in $(adapter_patterns "$dir"); do
		if [[ "$pattern" == "@dir" ]]; then
			[[ -d "$input" ]] && matched=0
		elif [[ ! -d "$input" ]]; then
			shopt -s nocasematch
			[[ "$name" == $pattern ]] && matched=0
			shopt -u nocasematch
		fi
		((matched == 0)) && break
	done
	set +f
	return $matched
}

# The name of an adapter without its ordering number: 10-ipa -> ipa
short_name() {
	echo "${1#[0-9]*-}"
}

# "name<TAB>directory" of the adapter for the path, or of the one asked for with --as
find_adapter() {
	local input="$1" wanted="${2:-}" name dir
	while IFS=$'\t' read -r name dir; do
		if [[ -n "$wanted" ]]; then
			[[ "$name" == "$wanted" || "$(short_name "$name")" == "$wanted" ]] || continue
		else
			adapter_matches "$dir" "$input" || continue
		fi
		if [[ ! -x "$dir/prepare" ]]; then
			echo "$PROG: warning: skipping adapter $name: $dir/prepare is missing or not executable" >&2
			[[ -n "$wanted" ]] && return 1
			continue
		fi
		printf '%s\t%s\n' "$name" "$dir"
		return 0
	done < <(list_adapters)
	return 1
}

show_adapters() {
	local name dir patterns note
	while IFS=$'\t' read -r name dir; do
		patterns="$(adapter_patterns "$dir")"
		note=""
		[[ -x "$dir/prepare" ]] || note="  (skipped: prepare is not executable)"
		printf '%-12s %-20s %s%s\n' "$name" "${patterns:-(no match file)}" "$dir" "$note"
	done < <(list_adapters)
}

# MARK: - Arguments

port=""
time_spec="1h"
quiet=0
adapter_wanted=""
mode="serve"
path=""
while (($#)); do
	case "$1" in
		-p | --port) (($# >= 2)) || usage_error "$1 needs a value"; port="$2"; shift 2 ;;
		--port=*) port="${1#*=}"; shift ;;
		-t | --time) (($# >= 2)) || usage_error "$1 needs a value"; time_spec="$2"; shift 2 ;;
		--time=*) time_spec="${1#*=}"; shift ;;
		-a | --as) (($# >= 2)) || usage_error "$1 needs a value"; adapter_wanted="$2"; shift 2 ;;
		--as=*) adapter_wanted="${1#*=}"; shift ;;
		-q | --quiet) quiet=1; shift ;;
		--adapters) mode="adapters"; shift ;;
		--which) mode="which"; shift ;;
		-h | --help) usage; exit 0 ;;
		-V | --version) echo "$PROG $VERSION"; exit 0 ;;
		--) shift; break ;;
		-*) usage_error "unknown option: $1" ;;
		*) [[ -z "$path" ]] || usage_error "only one path can be served"; path="$1"; shift ;;
	esac
done
if (($#)); then
	[[ -z "$path" && $# -eq 1 ]] || usage_error "only one path can be served"
	path="$1"
fi

if [[ "$mode" == "adapters" ]]; then
	show_adapters
	exit 0
fi

[[ -n "$path" ]] || usage_error "no path given"
[[ -z "$port" || "$port" =~ ^[0-9]+$ && "$port" -ge 1 && "$port" -le 65535 ]] || usage_error "invalid port: $port"
[[ "$time_spec" =~ ^[0-9]+[smh]?$ ]] || usage_error "invalid time: $time_spec"
[[ -e "$path" ]] || die "no such file or directory: $path"
[[ -r "$path" ]] || die "cannot read: $path"

case "$time_spec" in
	*h) seconds=$((${time_spec%h} * 3600)) ;;
	*m) seconds=$((${time_spec%m} * 60)) ;;
	*s) seconds=${time_spec%s} ;;
	*) seconds=$time_spec ;;
esac

if [[ -d "$path" ]]; then
	abs_path="$(cd "$path" && pwd -P)"
else
	abs_path="$(cd "$(dirname "$path")" && pwd -P)/$(basename "$path")"
fi

if ! found="$(find_adapter "$abs_path" "$adapter_wanted")"; then
	[[ -n "$adapter_wanted" ]] && die "no usable adapter named $adapter_wanted (see $PROG --adapters)"
	die "no adapter matches $path (see $PROG --adapters)"
fi
adapter_name="${found%%$'\t'*}"
adapter_dir="${found#*$'\t'}"

if [[ "$mode" == "which" ]]; then
	printf '%s\t%s\n' "$adapter_name" "$adapter_dir"
	exit 0
fi

say() {
	((quiet)) || echo "$*" >&2
}

# MARK: - Tools

tailscale_bin="$(command -v tailscale || true)"
if [[ -z "$tailscale_bin" && -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]]; then
	tailscale_bin=/Applications/Tailscale.app/Contents/MacOS/Tailscale
fi
[[ -n "$tailscale_bin" ]] || die "tailscale not found"
command -v python3 > /dev/null || die "python3 not found"

host="$("$tailscale_bin" status --json 2> /dev/null | python3 -c 'import json, sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2> /dev/null)" \
	|| die "tailscale is not running or not logged in"
[[ -n "$host" ]] || die "could not find this device's tailnet name"

# Whether tailscale serve already uses the port, for anything
serve_uses() {
	"$tailscale_bin" serve status --json 2> /dev/null \
		| python3 -c 'import json, sys; d = json.load(sys.stdin) or {}; sys.exit(0 if sys.argv[1] in (d.get("TCP") or {}) else 1)' "$1"
}

if [[ -z "$port" ]]; then
	for ((candidate = 10443; candidate <= 65443; candidate += 1000)); do
		if ! serve_uses "$candidate"; then
			port=$candidate
			break
		fi
	done
	[[ -n "$port" ]] || die "no free port among 10443, 11443, ... 65443; choose one with --port"
elif serve_uses "$port"; then
	die "port $port is already used by tailscale serve; choose another, or leave --port out"
fi
base_url="https://$host:$port"

# MARK: - What to serve

# Everything served lives in a temporary directory, removed on exit; adapters link to the path rather than copy it
root="$(mktemp -d "${TMPDIR:-/tmp}/tailshare.XXXXXX")"
server_pid=""
serving=0

cleanup() {
	trap - EXIT INT TERM HUP
	if ((serving)); then
		"$tailscale_bin" serve --https="$port" off > /dev/null 2>&1 || true
	fi
	if [[ -n "$server_pid" ]]; then
		kill "$server_pid" 2> /dev/null || true
		wait "$server_pid" 2> /dev/null || true
	fi
	rm -rf "$root"
	((serving)) && say "Stopped serving $base_url/"
	return 0
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP

# The adapter fills the site and prints the path to open, such as / or /report.html (not URL-encoded)
mkdir "$root/site"
url_path="$(TAILSHARE_ADAPTER_DIR="$adapter_dir" "$adapter_dir/prepare" "$abs_path" "$root/site" "$base_url")" \
	|| die "adapter $adapter_name failed for $path"
url_path="$(printf '%s\n' "$url_path" | tail -n 1)"
[[ "$url_path" == /* ]] || die "adapter $adapter_name printed no path to open (got: ${url_path:-nothing})"
url="$base_url$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe="/"))' "$url_path")"

# MARK: - Serve

local_port="$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')"
if ((quiet)); then
	python3 -m http.server "$local_port" --bind 127.0.0.1 --directory "$root/site" > /dev/null 2>&1 &
else
	python3 -m http.server "$local_port" --bind 127.0.0.1 --directory "$root/site" > /dev/null &
fi
server_pid=$!

# Wait until the local server answers before exposing it
for _ in $(seq 50); do
	python3 -c 'import socket, sys; socket.create_connection(("127.0.0.1", int(sys.argv[1])), 0.1)' "$local_port" 2> /dev/null && break
	kill -0 "$server_pid" 2> /dev/null || die "the local server failed to start"
	sleep 0.1
done

serving=1
"$tailscale_bin" serve --bg --https="$port" "http://127.0.0.1:$local_port" > /dev/null 2>&1 \
	|| die "tailscale serve failed (are HTTPS certificates enabled on the tailnet?)"

echo "$url"
if ((seconds > 0)); then
	say "Serving $path as $(short_name "$adapter_name") on your tailnet for $time_spec. Ctrl-C to stop."
else
	say "Serving $path as $(short_name "$adapter_name") on your tailnet. Ctrl-C to stop."
fi

start=$SECONDS
while kill -0 "$server_pid" 2> /dev/null; do
	if ((seconds > 0 && SECONDS - start >= seconds)); then
		say "Time is up ($time_spec)."
		exit 0
	fi
	sleep 1
done
die "the local server stopped"
