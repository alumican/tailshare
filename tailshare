#!/bin/bash
# tailshare: serve a file or a directory to your tailnet over HTTPS, and print its URL.
# Requires tailscale (HTTPS certificates enabled on the tailnet) and python3. See `tailshare --help`.

set -euo pipefail

VERSION="1.0.0"
PROG="$(basename "$0")"

usage() {
	cat <<EOF
Usage: $PROG [options] <path>

Serve a file or a directory to your tailnet over HTTPS, and print its URL.
Only devices on your tailnet can open it. Stops after --time or on Ctrl-C,
and leaves nothing behind.

  <path>            a file       https://<host>:<port>/<name>
                    a directory  https://<host>:<port>/  (its index.html, or a listing)
                    an .ipa      an install page for iPhone (the IPA must be signed
                                 for development or ad hoc, and the device registered)

Options:
  -p, --port PORT   tailnet HTTPS port (default: the first free of 10443, 11443, ...)
  -t, --time TIME   stop after TIME: 90, 30s, 10m, 2h, or 0 to keep serving (default: 1h)
  -q, --quiet       print nothing but the URL
  -h, --help        show this help
  -V, --version     show the version

The URL is the only thing written to stdout; messages and the request log go to
stderr (none with --quiet). Ports that tailscale serve already uses are never touched.

Examples:
  $PROG report.html            share one file for an hour
  $PROG -t 0 ./dist            share a built site until Ctrl-C
  $PROG -t 10m App.ipa         an iPhone install page for ten minutes

Requires: tailscale with HTTPS certificates enabled, python3
EOF
}

die() {
	echo "$PROG: $*" >&2
	exit 1
}

usage_error() {
	echo "$PROG: $*" >&2
	echo "Try '$PROG --help'." >&2
	exit 2
}

# MARK: - Arguments

port=""
time_spec="1h"
quiet=0
path=""
while (($#)); do
	case "$1" in
		-p | --port) (($# >= 2)) || usage_error "$1 needs a value"; port="$2"; shift 2 ;;
		--port=*) port="${1#*=}"; shift ;;
		-t | --time) (($# >= 2)) || usage_error "$1 needs a value"; time_spec="$2"; shift 2 ;;
		--time=*) time_spec="${1#*=}"; shift ;;
		-q | --quiet) quiet=1; shift ;;
		-h | --help) usage; exit 0 ;;
		-V | --version) echo "$PROG $VERSION"; exit 0 ;;
		--) shift; break ;;
		-*) usage_error "unknown option: $1" ;;
		*) [[ -z "$path" ]] || usage_error "only one path can be served"; path="$1"; shift ;;
	esac
done
if (($#)); then
	[[ -z "$path" && $# -eq 1 ]] || usage_error "only one path can be served"
	path="$1"
fi
[[ -n "$path" ]] || usage_error "no path given"
[[ -z "$port" || "$port" =~ ^[0-9]+$ && "$port" -ge 1 && "$port" -le 65535 ]] || usage_error "invalid port: $port"
[[ "$time_spec" =~ ^[0-9]+[smh]?$ ]] || usage_error "invalid time: $time_spec"
[[ -e "$path" ]] || die "no such file or directory: $path"
[[ -r "$path" ]] || die "cannot read: $path"

case "$time_spec" in
	*h) seconds=$((${time_spec%h} * 3600)) ;;
	*m) seconds=$((${time_spec%m} * 60)) ;;
	*s) seconds=${time_spec%s} ;;
	*) seconds=$time_spec ;;
esac

say() {
	((quiet)) || echo "$*" >&2
}

# MARK: - Tools

tailscale_bin="$(command -v tailscale || true)"
if [[ -z "$tailscale_bin" && -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ]]; then
	tailscale_bin=/Applications/Tailscale.app/Contents/MacOS/Tailscale
fi
[[ -n "$tailscale_bin" ]] || die "tailscale not found"
command -v python3 > /dev/null || die "python3 not found"

host="$("$tailscale_bin" status --json 2> /dev/null | python3 -c 'import json, sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2> /dev/null)" \
	|| die "tailscale is not running or not logged in"
[[ -n "$host" ]] || die "could not find this device's tailnet name"

# Whether tailscale serve already uses the port, for anything
serve_uses() {
	"$tailscale_bin" serve status --json 2> /dev/null \
		| python3 -c 'import json, sys; d = json.load(sys.stdin) or {}; sys.exit(0 if sys.argv[1] in (d.get("TCP") or {}) else 1)' "$1"
}

if [[ -z "$port" ]]; then
	for ((candidate = 10443; candidate <= 65443; candidate += 1000)); do
		if ! serve_uses "$candidate"; then
			port=$candidate
			break
		fi
	done
	[[ -n "$port" ]] || die "no free port among 10443, 11443, ... 65443; choose one with --port"
elif serve_uses "$port"; then
	die "port $port is already used by tailscale serve; choose another, or leave --port out"
fi
base_url="https://$host:$port"

# MARK: - What to serve

# Everything served lives in a temporary directory, removed on exit; the path itself is only linked to
root="$(mktemp -d "${TMPDIR:-/tmp}/tailshare.XXXXXX")"
server_pid=""
serving=0

cleanup() {
	trap - EXIT INT TERM HUP
	if ((serving)); then
		"$tailscale_bin" serve --https="$port" off > /dev/null 2>&1 || true
	fi
	if [[ -n "$server_pid" ]]; then
		kill "$server_pid" 2> /dev/null || true
		wait "$server_pid" 2> /dev/null || true
	fi
	rm -rf "$root"
	((serving)) && say "Stopped serving $base_url/"
	return 0
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP

if [[ -d "$path" ]]; then
	abs_path="$(cd "$path" && pwd -P)"
else
	abs_path="$(cd "$(dirname "$path")" && pwd -P)/$(basename "$path")"
fi
name="$(basename "$abs_path")"
url_name="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$name")"

if [[ -d "$abs_path" ]]; then
	ln -s "$abs_path" "$root/site"
	url="$base_url/"
	what="directory $path"
elif [[ "$name" == *.ipa ]]; then
	mkdir "$root/site"
	ln -s "$abs_path" "$root/site/$name"
	# Bust the device's cache, so a rebuilt IPA is always downloaded
	stamp="$(date -r "$abs_path" '+%s')"
	python3 - "$abs_path" "$root/site" "$base_url" "$url_name" "$stamp" <<'PY' || die "not a valid IPA: $path"
import html, plistlib, sys, time, zipfile
from pathlib import Path

ipa, site, base, url_name, stamp = sys.argv[1:]
with zipfile.ZipFile(ipa) as archive:
    plist = next(n for n in archive.namelist() if n.startswith("Payload/") and n.count("/") == 2 and n.endswith(".app/Info.plist"))
    info = plistlib.loads(archive.read(plist))
title = info.get("CFBundleDisplayName") or info.get("CFBundleName") or Path(ipa).stem
version = info.get("CFBundleShortVersionString", "")
manifest = {"items": [{
    "assets": [{"kind": "software-package", "url": f"{base}/{url_name}?v={stamp}"}],
    "metadata": {"bundle-identifier": info["CFBundleIdentifier"], "bundle-version": version, "kind": "software", "title": title},
}]}
Path(site, "manifest.plist").write_bytes(plistlib.dumps(manifest))
built = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(int(stamp)))
install = html.escape(f"itms-services://?action=download-manifest&url={base}/manifest.plist")
Path(site, "index.html").write_text(f"""<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{html.escape(title)}</title>
<style>body{{font-family:-apple-system,sans-serif;padding:48px 24px;text-align:center}}a{{display:inline-block;margin-top:24px;padding:16px 32px;border-radius:12px;background:#007aff;color:#fff;font-size:20px;text-decoration:none}}p{{color:#666}}</style>
</head>
<body>
<h1>{html.escape(title)}</h1>
<p>{html.escape(version)} / built {built}</p>
<a href="{install}">Install</a>
</body>
</html>
""", encoding="utf-8")
PY
	url="$base_url/"
	what="install page for $path"
else
	mkdir "$root/site"
	ln -s "$abs_path" "$root/site/$name"
	url="$base_url/$url_name"
	what="file $path"
fi

# MARK: - Serve

local_port="$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')"
if ((quiet)); then
	python3 -m http.server "$local_port" --bind 127.0.0.1 --directory "$root/site" > /dev/null 2>&1 &
else
	python3 -m http.server "$local_port" --bind 127.0.0.1 --directory "$root/site" > /dev/null &
fi
server_pid=$!

# Wait until the local server answers before exposing it
for _ in $(seq 50); do
	python3 -c 'import socket, sys; socket.create_connection(("127.0.0.1", int(sys.argv[1])), 0.1)' "$local_port" 2> /dev/null && break
	kill -0 "$server_pid" 2> /dev/null || die "the local server failed to start"
	sleep 0.1
done

serving=1
"$tailscale_bin" serve --bg --https="$port" "http://127.0.0.1:$local_port" > /dev/null 2>&1 \
	|| die "tailscale serve failed (are HTTPS certificates enabled on the tailnet?)"

echo "$url"
if ((seconds > 0)); then
	say "Serving $what on your tailnet for $time_spec. Ctrl-C to stop."
else
	say "Serving $what on your tailnet. Ctrl-C to stop."
fi

start=$SECONDS
while kill -0 "$server_pid" 2> /dev/null; do
	if ((seconds > 0 && SECONDS - start >= seconds)); then
		say "Time is up ($time_spec)."
		exit 0
	fi
	sleep 1
done
die "the local server stopped"
