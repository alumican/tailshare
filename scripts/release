#!/bin/bash
# Build the release archives into dist/: scripts/release v1.2.3
# One archive per platform (the binary, README.md and LICENSE), and SHA256SUMS. The archives are
# named without the version, so releases/latest/download/<archive> always gets the latest one.
# The version in main.go must match the tag, so `go install ...@v1.2.3` reports the same version.
set -euo pipefail

tag="${1:?usage: scripts/release v1.2.3}"
[[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "not a version tag: $tag" >&2; exit 2; }
version="${tag#v}"
cd "$(dirname "$0")/.."
in_source="$(sed -n 's/^var version = "\(.*\)"$/\1/p' main.go)"
[[ "$in_source" == "$version" ]] || { echo "main.go says $in_source, the tag says $version" >&2; exit 1; }

rm -rf dist
mkdir -p dist/stage
for platform in darwin/arm64 darwin/amd64 linux/amd64 linux/arm64 windows/amd64 windows/arm64; do
	os="${platform%/*}" arch="${platform#*/}"
	name="tailshare_${os}_${arch}"
	binary="tailshare"
	[[ "$os" == windows ]] && binary="tailshare.exe"
	rm -rf dist/stage/*
	CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build -trimpath -ldflags "-s -w -X main.version=$version" -o "dist/stage/$binary" .
	cp README.md LICENSE dist/stage/
	if [[ "$os" == windows ]]; then
		(cd dist/stage && zip -q -X "../$name.zip" "$binary" README.md LICENSE)
	else
		tar -C dist/stage -czf "dist/$name.tar.gz" "$binary" README.md LICENSE
	fi
done
rm -rf dist/stage
sums="$(cd dist && if command -v sha256sum > /dev/null; then sha256sum -- *.tar.gz *.zip; else shasum -a 256 -- *.tar.gz *.zip; fi)"
echo "$sums" > dist/SHA256SUMS
ls dist
